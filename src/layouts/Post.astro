---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import Base from "./Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { dicts, homePath, otherLang, postPath, writingPath } from "../i18n";

interface Props { post: CollectionEntry<"writing"> }
const { post } = Astro.props;
const { lang, slug, translation, title, lead, description, date } = post.data;
const t = dicts[lang].writing;
const { Content } = await render(post);
const other = otherLang(lang);
const otherHref = translation ? postPath(other, translation) : homePath(other);
const alternates = { [lang]: postPath(lang, slug), ...(translation ? { [other]: otherHref } : {}) };
const site = Astro.site!;
const url = new URL(postPath(lang, slug), site).href;
const image = `/og/${lang}/${slug}.png`;
const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description: description ?? lead,
  datePublished: date.toISOString().slice(0, 10),
  inLanguage: lang,
  url,
  mainEntityOfPage: url,
  image: new URL(image, site).href,
  author: { "@type": "Person", name: "Kamil Wałdoch", url: new URL(homePath(lang), site).href },
};
const fmt = new Intl.DateTimeFormat(lang === "pl" ? "pl-PL" : "en-GB", { day: "numeric", month: "long", year: "numeric" });
---
<Base lang={lang} title={`${title} · Kamil Wałdoch`} description={description ?? lead} alternates={alternates} type="article" image={image} publishedTime={date} schema={schema}>
  <Nav lang={lang} switchHref={otherHref} />
  <main>
    <article class="post wrap">
      <a class="post-back chip" href={writingPath(lang)}>{t.back}</a>
      <p class="eyebrow"><time datetime={date.toISOString().slice(0, 10)}>{fmt.format(date)}</time></p>
      <h1 class="post-title" style={`view-transition-name: post-${slug}`}>{title}</h1>
      <p class="post-lead">{lead}</p>
      <div class="post-body"><Content /></div>
      <aside class="post-cta">
        <p>{t.ctaText}</p>
        <a class="btn btn-signal" href={`${homePath(lang)}#contact`}>{t.ctaLink} →</a>
      </aside>
      <p class="post-foot">
        {translation && <a class="link" href={otherHref} hreflang={other}>{t.otherLang} →</a>}
      </p>
    </article>
  </main>
  <Footer lang={lang} />
</Base>

<style>
  .post { max-width: calc(68ch + 2 * var(--gutter)); padding-block: var(--space-6) var(--section-pad); }
  .post-back { display: inline-flex; padding: 0.55rem 0.95rem; text-decoration: none; margin-bottom: var(--space-6); transition: background 0.15s ease, color 0.15s ease; }
  .post-cta { margin-top: var(--space-6); padding-top: var(--space-5); border-top: 1px solid var(--line); display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-4); }
  .post-cta p { font-size: var(--fs-lead); }
  .post-back:hover { background: var(--ink); color: var(--ground); }
  .post-title { font-size: var(--fs-display-l); margin-bottom: var(--space-4); text-wrap: balance; }
  .post-lead { font-size: var(--fs-lead); color: var(--ink-muted); line-height: 1.45; margin-bottom: var(--space-5); padding-bottom: var(--space-5); border-bottom: 1px solid var(--line); }
  .post-body :global(p) { margin-bottom: 1.25rem; }
  .post-body :global(h2) { font-size: var(--fs-heading); margin: var(--space-5) 0 var(--space-3); }
  .post-body :global(h3) { font-size: 1.25rem; margin: var(--space-4) 0 var(--space-2); }
  .post-body :global(ul), .post-body :global(ol) { margin: 0 0 1.25rem 1.2rem; }
  .post-body :global(li) { margin-bottom: 0.35rem; }
  .post-body :global(li::marker) { color: var(--signal-ink); }
  .post-body :global(strong) { font-weight: 500; }
  .post-body :global(a) { font-weight: 500; text-decoration-color: var(--signal-ink); text-decoration-thickness: 1.5px; text-underline-offset: 0.25em; }
  .post-body :global(blockquote) { font-size: var(--fs-lead); font-weight: 300; padding-left: var(--space-4); border-left: 1px solid var(--line-strong); margin: var(--space-5) 0; }
  .post-foot { margin-top: var(--space-6); }
</style>
