---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import Base from "./Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { dicts, homePath, otherLang, postPath } from "../i18n";

interface Props { post: CollectionEntry<"writing"> }
const { post } = Astro.props;
const { lang, slug, translation, title, lead, date } = post.data;
const t = dicts[lang].writing;
const { Content } = await render(post);
const other = otherLang(lang);
const otherHref = translation ? postPath(other, translation) : homePath(other);
const alternates = { [lang]: postPath(lang, slug), ...(translation ? { [other]: otherHref } : {}) };
const fmt = new Intl.DateTimeFormat(lang === "pl" ? "pl-PL" : "en-GB", { day: "numeric", month: "long", year: "numeric" });
---
<Base lang={lang} title={`${title} · Kamil Wałdoch`} description={lead} alternates={alternates} type="article">
  <Nav lang={lang} switchHref={otherHref} />
  <main>
    <article class="post wrap">
      <a class="post-back" href={`${homePath(lang)}#writing`}>{t.back}</a>
      <p class="eyebrow"><time datetime={date.toISOString().slice(0, 10)}>{fmt.format(date)}</time></p>
      <h1 class="post-title">{title}</h1>
      <p class="post-lead">{lead}</p>
      <div class="post-body"><Content /></div>
      <p class="post-foot">
        {translation && <a href={otherHref} hreflang={other}>{t.otherLang} →</a>}
      </p>
    </article>
  </main>
  <Footer />
</Base>

<style>
  .post { max-width: calc(68ch + 2 * var(--gutter)); padding-block: clamp(3rem, 7vw, 5rem); }
  .post-back {
    display: block;
    width: fit-content;
    font-size: var(--step--1);
    color: var(--ink-soft);
    text-decoration: none;
    margin-bottom: 2rem;
  }
  .post-back:hover { color: var(--accent); }
  .post-title { font-size: var(--step-3); margin-bottom: 1rem; }
  .post-lead { font-size: var(--step-1); color: var(--ink-soft); line-height: 1.45; margin-bottom: 2.5rem; }
  .post-body :global(p) { margin-bottom: 1.2rem; }
  .post-body :global(ul) { margin: 0 0 1.2rem 1.2rem; }
  .post-body :global(li) { margin-bottom: 0.3rem; }
  .post-foot { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }
  .post-foot a { color: var(--accent); font-weight: 600; text-decoration: none; }
</style>
