---
import { SITE } from "../i18n";
---
<footer class="foot">
  <div class="wrap foot-inner">
    <span>© {new Date().getFullYear()} Kamil Wałdoch · SoftArm · Gdynia</span>
    <div class="foot-links">
      <a href={SITE.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
      <a href={`mailto:${SITE.email}`}>E-mail</a>
    </div>
  </div>
</footer>

<style>
  .foot { padding-block: var(--space-5); border-top: 1px solid var(--line); }
  .foot-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-size: var(--fs-small);
    color: var(--ink-muted);
  }
  .foot-links { display: flex; gap: var(--space-4); }
  .foot-links a { font-weight: 400; text-decoration: none; transition: color 0.15s ease; }
  .foot-links a:hover { color: var(--ink); }
</style>
