---
import { dicts, SITE, type Lang } from "../i18n";
interface Props { lang: Lang }
const t = dicts[Astro.props.lang].contact;
---
<section id="contact" class="cta">
  <div class="wrap cta-inner">
    <h2 class="cta-title">{t.title}</h2>
    <p class="cta-lead">{t.lead}</p>
    <div class="cta-actions">
      <a href={`mailto:${SITE.email}`} class="btn btn-primary">{SITE.email}</a>
      <a href={SITE.linkedin} class="cta-mail" target="_blank" rel="noopener">LinkedIn</a>
    </div>

    <p class="cta-or">{t.or}</p>

    <form
      class="cta-form"
      action="https://api.web3forms.com/submit"
      method="POST"
      data-sending={t.form.sending}
      data-error={t.form.error}
    >
      <input type="hidden" name="access_key" value="648bd1f4-c027-43d2-a56f-1301e439d1f7" />
      <input type="hidden" name="subject" value={t.form.subject} />
      <input type="hidden" name="from_name" value="softarm.pl" />
      <input type="checkbox" name="botcheck" class="cta-hp" tabindex="-1" autocomplete="off" />

      <div class="cta-row">
        <input type="text" name="name" placeholder={t.form.name} aria-label={t.form.name} required autocomplete="name" />
        <input type="email" name="email" placeholder={t.form.email} aria-label={t.form.email} required autocomplete="email" />
      </div>
      <textarea name="message" rows="5" placeholder={t.form.message} aria-label={t.form.message} required></textarea>
      <button type="submit" class="btn btn-primary cta-submit">{t.form.submit}</button>
      <p class="cta-status" role="status" aria-live="polite"></p>
      <div class="cta-success" role="status" aria-live="polite">
        <span class="cta-success-mark" aria-hidden="true">✓</span>
        <p class="cta-success-title">{t.form.successTitle}</p>
        <p class="cta-success-sub">{t.form.successSub}</p>
      </div>
    </form>
  </div>
</section>

<style>
  .cta { background: var(--accent-wash); border-block: 1px solid var(--line); }
  .cta-inner { text-align: center; }
  .cta-title { font-size: var(--step-3); margin-bottom: 1.5rem; }
  .cta-lead { color: var(--ink-soft); margin-bottom: 2rem; }
  .cta-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .cta-mail {
    font-family: var(--mono);
    font-size: var(--step-0);
    text-decoration: none;
    border-bottom: 2px solid var(--line);
    padding-bottom: 2px;
  }
  .cta-mail:hover { border-color: var(--accent); }

  .cta-or {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    margin-bottom: 1.6rem;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .cta-form {
    max-width: 560px;
    margin-inline: auto;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    background: var(--paper-pure);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: clamp(1.6rem, 4vw, 2.6rem);
  }
  .cta-row {
    display: flex;
    gap: 1.1rem;
  }
  .cta-form input[type="text"],
  .cta-form input[type="email"],
  .cta-form textarea {
    width: 100%;
    font-family: var(--body);
    font-size: var(--step-0);
    color: var(--ink);
    background: var(--paper-pure);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 0.85rem 1rem;
    transition: border-color 0.15s ease;
  }
  .cta-form input:focus,
  .cta-form textarea:focus {
    outline: none;
    border-color: var(--accent);
  }
  .cta-form textarea { resize: vertical; min-height: 150px; }
  .cta-submit { align-self: center; margin-top: 0.4rem; }
  /* honeypot - ukryty przed ludźmi, widoczny dla botów */
  .cta-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .cta-status {
    font-size: var(--step--1);
    color: var(--ink-soft);
    min-height: 1.2em;
  }
  .cta-status.ok { color: var(--accent); }
  .cta-status.err { color: #b23b3b; }

  /* Stan po wysłaniu - chowamy pola, pokazujemy potwierdzenie */
  .cta-success { display: none; text-align: center; padding: 1.5rem 0; }
  .cta-form.sent .cta-row,
  .cta-form.sent textarea,
  .cta-form.sent .cta-submit,
  .cta-form.sent .cta-status { display: none; }
  .cta-form.sent .cta-success { display: block; }
  .cta-success-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }
  .cta-success-title {
    font-family: var(--display);
    font-size: var(--step-1);
    color: var(--ink);
    margin-bottom: 0.4rem;
  }
  .cta-success-sub { font-size: var(--step-0); color: var(--ink-soft); }
  @media (max-width: 520px) {
    .cta-row { flex-direction: column; }
  }

</style>

<script>
  const form = document.querySelector<HTMLFormElement>(".cta-form");
  const status = form?.querySelector<HTMLParagraphElement>(".cta-status");
  const submit = form?.querySelector<HTMLButtonElement>(".cta-submit");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!status || !submit) return;
    if (form.classList.contains("sent")) return; // już wysłane - blokuj dubel

    status.className = "cta-status";
    status.textContent = form.dataset.sending ?? "…";
    submit.disabled = true;

    try {
      const res = await fetch(form.action, {
        method: "POST",
        headers: { Accept: "application/json" },
        body: new FormData(form),
      });
      const data = await res.json();
      if (res.ok && data.success) {
        status.textContent = "";
        form.classList.add("sent"); // chowa pola i przycisk, pokazuje potwierdzenie
      } else {
        throw new Error(data.message || "błąd");
      }
    } catch {
      status.className = "cta-status err";
      status.textContent = form.dataset.error ?? "Error";
      submit.disabled = false; // pozwól spróbować ponownie tylko po błędzie
    }
  });
</script>
