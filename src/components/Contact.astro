---
import Dotted from "./Dotted.astro";
import { dicts, SITE, type Lang } from "../i18n";
interface Props { lang: Lang }
const d = dicts[Astro.props.lang];
const t = d.contact;
---
<section id="contact" class="cta">
  <div class="wrap">
    <header class="cta-head">
      <p class="eyebrow">{d.nav.contact}</p>
      <h2 class="cta-title"><Dotted text={t.title} /></h2>
    </header>
    <div class="cta-block">
      <div class="cta-direct">
        <p class="cta-lead">{t.lead}</p>
        <!-- Główna droga to formularz ("Wyślij"). Mail jako spokojny wiersz dla tych, którzy wolą własną skrzynkę.
             LinkedIn tylko w stopce, żeby nie konkurował z formularzem. -->
        <dl class="cta-info">
          <div>
            <dt class="label">{t.form.email}</dt>
            <dd><a class="link" href={`mailto:${SITE.email}`}>{SITE.email}</a></dd>
          </div>
        </dl>
      </div>

      <form
        class="cta-form"
        action="https://api.web3forms.com/submit"
        method="POST"
        data-sending={t.form.sending}
        data-error={t.form.error}
      >
        <input type="hidden" name="access_key" value="648bd1f4-c027-43d2-a56f-1301e439d1f7" />
        <input type="hidden" name="subject" value={t.form.subject} />
        <input type="hidden" name="from_name" value="softarm.pl" />
        <input type="checkbox" name="botcheck" class="cta-hp" tabindex="-1" autocomplete="off" />

        <div class="cta-row">
          <label class="cta-field">
            <span class="cta-label">{t.form.name}</span>
            <input type="text" name="name" required autocomplete="name" />
          </label>
          <label class="cta-field">
            <span class="cta-label">{t.form.email}</span>
            <input type="email" name="email" required autocomplete="email" />
          </label>
        </div>
        <label class="cta-field cta-msg">
          <span class="cta-label">{t.form.message}</span>
          <textarea name="message" rows="5" required></textarea>
        </label>
        <button type="submit" class="btn btn-signal cta-submit">{t.form.submit}</button>
        <p class="cta-status" role="status" aria-live="polite"></p>
        <div class="cta-success" role="status" aria-live="polite">
          <span class="cta-success-mark" aria-hidden="true">✓</span>
          <p class="cta-success-title">{t.form.successTitle}</p>
          <p class="cta-success-sub">{t.form.successSub}</p>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .cta-block {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(var(--space-5), 7vw, var(--space-7));
    align-items: start;
  }
  .cta-head { margin-bottom: var(--space-6); }
  /* Nagłówek na całą szerokość; na wąskim ekranie skalowany do szerokości,
     bo "Porozmawiajmy" to jedno długie słowo */
  .cta-title { font-size: min(var(--fs-display-xl), 11.5vw); line-height: 0.92; letter-spacing: -0.045em; }
  .cta-lead { font-size: var(--fs-lead); line-height: 1.45; max-width: 36ch; margin-bottom: var(--space-5); }
  .cta-info { border-top: 1px solid var(--line-strong); }
  .cta-info > div {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: var(--space-3);
    align-items: baseline;
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--line);
  }
  .cta-info dd { overflow-wrap: anywhere; }
  .cta-info .link { font-weight: 400; }

  .cta-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .cta-row { display: flex; gap: var(--space-4); }
  .cta-field { display: flex; flex-direction: column; gap: var(--space-2); flex: 1; }
  .cta-label { font-family: var(--font-display); font-size: var(--fs-label); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-muted); }
  .cta-form input[type="text"],
  .cta-form input[type="email"],
  .cta-form textarea {
    width: 100%;
    font-family: var(--font-text);
    font-size: var(--fs-body);
    font-weight: 400;
    color: var(--ink);
    background: var(--ground-raised);
    border: 1px solid var(--control);
    border-radius: var(--radius-0);
    padding: 0.9rem 1rem;
    transition: border-color 0.15s ease;
  }
  .cta-form input:hover,
  .cta-form textarea:hover { border-color: var(--ink); }
  .cta-form textarea { resize: vertical; min-height: 160px; }
  .cta-submit { align-self: flex-start; }
  /* honeypot - ukryty przed ludźmi, widoczny dla botów */
  .cta-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .cta-status { font-size: var(--fs-small); color: var(--ink-muted); min-height: 1.2em; }
  .cta-status.ok { color: var(--ink); }
  .cta-status.err { color: var(--error); }

  /* Stan po wysłaniu - chowamy pola, pokazujemy potwierdzenie */
  .cta-success { display: none; padding: var(--space-5) 0; }
  .cta-form.sent .cta-row,
  .cta-form.sent .cta-msg,
  .cta-form.sent .cta-submit,
  .cta-form.sent .cta-status { display: none; }
  .cta-form.sent .cta-success { display: block; }
  .cta-success-mark {
    display: inline-grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--radius-pill);
    background: var(--signal);
    color: var(--on-signal);
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: var(--space-4);
  }
  .cta-success-title { font-family: var(--font-display); font-size: var(--fs-heading); font-weight: 800; letter-spacing: -0.03em; line-height: 1.1; margin-bottom: var(--space-2); }
  .cta-success-sub { color: var(--ink-muted); }
  @media (max-width: 860px) {
    .cta-block { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .cta-row { flex-direction: column; }
    .cta-info > div { grid-template-columns: 1fr; gap: var(--space-1); }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>(".cta-form");
  const status = form?.querySelector<HTMLParagraphElement>(".cta-status");
  const submit = form?.querySelector<HTMLButtonElement>(".cta-submit");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!status || !submit) return;
    if (form.classList.contains("sent")) return; // już wysłane - blokuj dubel

    status.className = "cta-status";
    status.textContent = form.dataset.sending ?? "…";
    submit.disabled = true;

    try {
      const res = await fetch(form.action, {
        method: "POST",
        headers: { Accept: "application/json" },
        body: new FormData(form),
      });
      const data = await res.json();
      if (res.ok && data.success) {
        status.textContent = "";
        form.classList.add("sent"); // chowa pola i przycisk, pokazuje potwierdzenie
      } else {
        throw new Error(data.message || "błąd");
      }
    } catch {
      status.className = "cta-status err";
      status.textContent = form.dataset.error ?? "Error";
      submit.disabled = false; // pozwól spróbować ponownie tylko po błędzie
    }
  });
</script>
