---
import { getCollection } from "astro:content";
import { dicts, postPath, type Lang } from "../i18n";
import SectionHeader from "./SectionHeader.astro";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dicts[lang].writing;
const posts = (await getCollection("writing", (p) => p.data.lang === lang)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const fmt = new Intl.DateTimeFormat(lang === "pl" ? "pl-PL" : "en-GB", { day: "numeric", month: "long", year: "numeric" });
---
<section id="writing" class="wr paper">
  <div class="wrap">
    <SectionHeader eyebrow={t.eyebrow} title={t.title} />
    <ul class="wr-list">
      {posts.map((p) => (
        <li>
          <a class="wr-item" href={postPath(lang, p.data.slug)}>
            <time class="wr-date" datetime={p.data.date.toISOString().slice(0, 10)}>{fmt.format(p.data.date)}</time>
            <span class="wr-h">{p.data.title}</span>
            <span class="wr-lead">{p.data.lead}</span>
            <span class="wr-go" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .wr-list { list-style: none; border-top: 1px solid var(--line-strong); }
  .wr-item {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr) 2rem;
    gap: var(--space-2) var(--space-5);
    align-items: baseline;
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .wr-date { grid-row: 1 / span 2; font-size: var(--fs-small); color: var(--ink-muted); }
  .wr-h {
    font-family: var(--font-display);
    font-size: var(--fs-heading);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    transition: text-decoration-color 0.15s ease;
  }
  .wr-lead { grid-column: 2; color: var(--ink-muted); max-width: 60ch; }
  .wr-go { grid-column: 3; grid-row: 1; justify-self: end; font-size: 1.5rem; transition: transform 0.15s ease; }
  .wr-item:hover .wr-h { text-decoration-color: currentColor; }
  .wr-item:hover .wr-go { transform: translateX(4px); }
  @media (max-width: 760px) {
    .wr-item { grid-template-columns: minmax(0, 1fr) 2rem; }
    .wr-date { grid-row: auto; grid-column: 1; }
    .wr-h { grid-column: 1; }
    .wr-lead { grid-column: 1; }
    .wr-go { grid-row: 2; grid-column: 2; }
  }
</style>
