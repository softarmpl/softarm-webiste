---
import { getCollection } from "astro:content";
import { dicts, postPath, type Lang } from "../i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dicts[lang].writing;
const posts = (await getCollection("writing", (p) => p.data.lang === lang)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const fmt = new Intl.DateTimeFormat(lang === "pl" ? "pl-PL" : "en-GB", { month: "long", year: "numeric" });
---
<section id="writing" class="wr">
  <div class="wrap">
    <p class="eyebrow">{t.eyebrow}</p>
    <h2 class="wr-title">{t.title}</h2>
    <ul class="wr-list">
      {posts.map((p) => (
        <li>
          <a class="wr-item" href={postPath(lang, p.data.slug)}>
            <span class="wr-date">{fmt.format(p.data.date)}</span>
            <span class="wr-text">
              <span class="wr-h">{p.data.title}</span>
              <span class="wr-lead">{p.data.lead}</span>
            </span>
            <span class="wr-go" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .wr { background: var(--paper-pure); border-block: 1px solid var(--line); }
  .wr-title { font-size: var(--step-3); margin-bottom: clamp(2rem, 5vw, 3rem); }
  .wr-list { list-style: none; border-top: 1px solid var(--line); max-width: 900px; }
  .wr-item {
    display: grid;
    grid-template-columns: 9rem 1fr auto;
    gap: 1.5rem;
    align-items: baseline;
    padding-block: 1.4rem;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .wr-date { font-family: var(--mono); font-size: var(--step--1); color: var(--ink-soft); }
  .wr-h { display: block; font-family: var(--display); font-size: var(--step-1); line-height: 1.2; margin-bottom: 0.3rem; }
  .wr-lead { display: block; color: var(--ink-soft); font-size: var(--step--1); }
  .wr-go { color: var(--accent); font-family: var(--mono); transition: transform 0.15s ease; }
  .wr-item:hover .wr-h { color: var(--accent); }
  .wr-item:hover .wr-go { transform: translateX(4px); }
  @media (max-width: 640px) {
    .wr-item { grid-template-columns: 1fr; gap: 0.4rem; }
    .wr-go { display: none; }
  }
</style>
