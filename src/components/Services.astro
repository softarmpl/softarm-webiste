---
import Dotted from "./Dotted.astro";
import { dicts, type Lang } from "../i18n";
interface Props { lang: Lang }
const t = dicts[Astro.props.lang].services;
---
<section id="services" class="svc">
  <div class="wrap">
    <div class="svc-block">
      <div class="svc-head" data-reveal-group>
        <p class="eyebrow">{t.eyebrow}</p>
        <h2 class="svc-title"><Dotted text={t.title} /></h2>
        <p class="svc-lead">{t.lead}</p>
        <a href="#contact" class="btn btn-signal">{t.cta} →</a>
      </div>
      <ol class="svc-list" data-reveal-group>
        {t.items.map((i, n) => (
          <li class="svc-item">
            <span class="svc-n" aria-hidden="true">{String(n + 1).padStart(2, "0")}</span>
            <div>
              <h3 class="svc-h">{i.title}</h3>
              <p class="svc-body">{i.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .svc-block {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: clamp(var(--space-5), 7vw, var(--space-7));
    align-items: start;
  }
  .svc-head { position: sticky; top: 112px; }
  .svc-title { font-size: var(--fs-display-l); margin-bottom: var(--space-4); text-wrap: balance; }
  .svc-lead { font-size: var(--fs-lead); line-height: 1.45; color: var(--ink-muted); max-width: 40ch; margin-bottom: var(--space-5); }
  .svc-list { list-style: none; border-top: 1px solid var(--line-strong); }
  .svc-item {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: var(--space-3);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--line);
  }
  .svc-n {
    font-family: var(--font-display);
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--signal-ink);
    padding-top: 0.5rem;
  }
  .svc-h { font-size: var(--fs-heading); margin-bottom: var(--space-3); text-wrap: balance; }
  .svc-body { color: var(--ink-muted); max-width: 52ch; }
  @media (max-width: 860px) {
    .svc-block { grid-template-columns: 1fr; }
    .svc-head { position: static; }
  }
</style>
