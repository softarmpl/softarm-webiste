---
import { dicts, SITE, type Lang } from "../i18n";
interface Props { lang: Lang }
const t = dicts[Astro.props.lang].services;
---
<section id="services" class="svc">
  <div class="wrap svc-grid">
    <div>
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 class="svc-title">{t.title}</h2>
      <p class="svc-lead">{t.lead}</p>
      <a href={`mailto:${SITE.email}`} class="hero-link svc-cta">{t.cta} →</a>
    </div>
    <ul class="svc-list">
      {t.items.map((i) => (
        <li class="svc-item">
          <h3 class="svc-h">{i.title}</h3>
          <p class="svc-body">{i.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .svc-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(2rem, 6vw, 4.5rem);
    align-items: start;
  }
  .svc-title { font-size: var(--step-3); margin-bottom: 1.2rem; }
  .svc-lead { color: var(--ink-soft); max-width: 44ch; margin-bottom: 1.6rem; }
  .svc-cta {
    font-weight: 600;
    text-decoration: none;
    border-bottom: 2px solid var(--line);
    padding-bottom: 2px;
    transition: border-color 0.15s ease;
  }
  .svc-cta:hover { border-color: var(--accent); }
  .svc-list { list-style: none; }
  .svc-item { padding-block: 1.3rem; border-top: 1px solid var(--line); }
  .svc-item:first-child { padding-top: 0; border-top: 0; }
  .svc-h { font-size: var(--step-1); margin-bottom: 0.4rem; }
  .svc-body { color: var(--ink-soft); }
  @media (max-width: 820px) {
    .svc-grid { grid-template-columns: 1fr; }
  }
</style>
