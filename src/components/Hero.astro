---
import Dotted from "./Dotted.astro";
import { dicts, SITE, type Lang } from "../i18n";
interface Props { lang: Lang }
const t = dicts[Astro.props.lang].hero;
const name = t.name.replace(/\.$/, "");
---
<section id="top" class="hero">
  <div class="wrap">
    <div class="hero-grid">
      <div class="hero-main">
        <p class="eyebrow">{t.eyebrow}</p>
        <h1 class="hero-name"><Dotted text={name} /></h1>
        <p class="hero-lead">{t.lead}</p>
        <div class="hero-actions">
          <a href={`mailto:${SITE.email}`} class="btn btn-signal">{t.ctaPrimary} →</a>
          <a href="#work" class="link">{t.ctaSecondary} ↓</a>
        </div>
      </div>

      <figure class="hero-photo">
        <img src="/kamil-portrait.jpg" alt="Kamil Wałdoch" width="800" height="1000" />
      </figure>
    </div>

    <ul class="hero-stats">
      {t.stats.map((s) => (
        <li><strong>{s.n}</strong><span>{s.l}</span></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hero { padding-top: clamp(var(--space-6), 8vw, var(--space-7)); padding-bottom: var(--space-6); }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 300px);
    align-items: end;
    gap: clamp(var(--space-5), 5vw, var(--space-6));
  }
  .hero-main .eyebrow { margin-bottom: var(--space-5); }
  .hero-name {
    font-size: var(--fs-display-xl);
    line-height: 0.92;
    letter-spacing: -0.045em;
    max-width: 14ch;
    text-wrap: balance;
    overflow-wrap: break-word;
    margin-bottom: var(--space-5);
  }
  .hero-lead { font-size: var(--fs-lead); line-height: 1.45; max-width: 48ch; }
  .hero-actions { display: flex; align-items: center; gap: var(--space-5); flex-wrap: wrap; margin-top: var(--space-5); }

  /* Portret w zwykłym prostokącie, bez zaokrągleń */
  .hero-photo { margin: 0; }
  .hero-photo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 30%;
  }

  .hero-stats {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: clamp(var(--space-6), 8vw, var(--space-7));
    border-top: 1px solid var(--line);
  }
  .hero-stats li {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-4) 0 0;
  }
  .hero-stats li + li { padding-left: var(--space-4); border-left: 1px solid var(--line); }
  .hero-stats strong {
    font-family: var(--font-display);
    font-size: var(--fs-heading);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--signal-ink);
  }
  .hero-stats span { font-size: var(--fs-small); color: var(--ink-muted); }

  @media (max-width: 820px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-photo { order: -1; width: 96px; }
    .hero-photo img { aspect-ratio: 1; }
    .hero-main .eyebrow { margin-bottom: var(--space-4); }
    .hero-stats { grid-template-columns: 1fr; }
    .hero-stats li, .hero-stats li + li { padding: var(--space-3) 0; border-left: 0; border-bottom: 1px solid var(--line); flex-direction: row; align-items: baseline; gap: var(--space-3); }
  }
</style>
