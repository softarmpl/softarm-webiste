---
import { dicts, type Lang } from "../i18n";
interface Props { lang: Lang }
const t = dicts[Astro.props.lang].hero;
// Nagłówek-pytanie: pytajnik w kolorze sygnału zamiast kropki.
const isQuestion = t.name.endsWith("?");
const name = t.name.replace(/[.?]$/, "");
// Każde słowo nagłówka w osobnej masce, żeby wjechało od dołu. Kropka przyklejona do ostatniego.
const words = name.split(" ");
// Eyebrow "Imię · rola": na telefonie dwie linie obok zdjęcia, separator ukryty.
const [eyeName, eyeRole] = t.eyebrow.split(" · ");
---
<section id="top" class="hero">
  <div class="wrap">
    <div class="hero-grid">
      <div class="hero-main">
        <p class="eyebrow"><span>{eyeName}</span>{eyeRole && <><span class="eb-sep" aria-hidden="true"> · </span><span>{eyeRole}</span></>}</p>
        <h1 class="hero-name">
          {words.map((w, i) => (
            <><span class="hm"><span class="hm-in" style={`--d:${i}`}>{w}{i === words.length - 1 && (isQuestion ? <span class="q">?</span> : <span class="dot" aria-hidden="true"></span>)}</span></span>{i < words.length - 1 && " "}</>
          ))}
        </h1>
        <p class="hero-lead">{t.lead}</p>
        <div class="hero-actions">
          <a href="#contact" class="btn btn-signal">{t.ctaPrimary} →</a>
        </div>
      </div>

      <figure class="hero-photo">
        <img src="/kamil-portrait.jpg" alt="Kamil Wałdoch" width="800" height="1000" />
      </figure>
    </div>

    <ul class="hero-stats">
      {t.stats.map((s) => (
        <li><strong>{s.n}</strong><span>{s.l}</span></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .q { color: var(--signal); }
  .hero { padding-top: clamp(var(--space-6), 8vw, var(--space-7)); padding-bottom: var(--space-6); }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 300px);
    align-items: end;
    gap: clamp(var(--space-5), 5vw, var(--space-6));
  }
  .hero-main .eyebrow { margin-bottom: var(--space-5); }
  .hero-name {
    /* 13vw: na bardzo wąskich ekranach (~320 px) najdłuższe słowo z kropką mieści się w linii */
    font-size: min(var(--fs-display-xl), 13vw);
    line-height: 0.92;
    letter-spacing: -0.045em;
    max-width: 14ch;
    text-wrap: balance;
    overflow-wrap: break-word;
    margin-bottom: var(--space-5);
  }
  /* Maska słowa: zapas na dole i górze, żeby nie ucinać znaków diakrytycznych i ogonków */
  .hm { display: inline-block; overflow: hidden; white-space: nowrap; vertical-align: top; padding-block: 0.06em 0.1em; margin-block: -0.06em -0.1em; }
  .hm-in { display: inline-block; }
  .hero-lead { font-size: var(--fs-lead); line-height: 1.45; max-width: 48ch; }
  .hero-actions { display: flex; align-items: center; gap: var(--space-5); flex-wrap: wrap; margin-top: var(--space-5); }

  /* Portret w zwykłym prostokącie, bez zaokrągleń */
  .hero-photo {
    margin: 0;
    /* Dół portretu (koszula) płynnie znika w tle strony. Maska na figure, nie na img,
       żeby zoom przy wejściu nie przesuwał zaniku. */
    --fade: linear-gradient(to bottom, #000 55%, rgb(0 0 0 / 0.6) 72%, rgb(0 0 0 / 0.2) 88%, transparent 100%);
    -webkit-mask-image: var(--fade);
    mask-image: var(--fade);
  }
  .hero-photo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 30%;
  }

  .hero-stats {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: clamp(var(--space-6), 8vw, var(--space-7));
    border-top: 1px solid var(--line);
  }
  .hero-stats li {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-4) 0 0;
  }
  .hero-stats li + li { padding-left: var(--space-4); border-left: 1px solid var(--line); }
  .hero-stats strong {
    font-family: var(--font-display);
    font-size: var(--fs-heading);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--signal-ink);
  }
  .hero-stats span { font-size: var(--fs-small); color: var(--ink-muted); }

  /* Wejście: słowa nagłówka spod maski, przyciski i liczby kaskadą, zdjęcie z lekkim zoomem.
     Eyebrow i lead stoją od pierwszej klatki: lead to element LCP na telefonie,
     a start z opacity 0 przesuwa pomiar LCP o czas animacji. Maska i zoom to sam transform, LCP bez zmian. */
  .hero-photo { overflow: hidden; }
  @media (prefers-reduced-motion: no-preference) {
    .hm-in { animation: line-up 0.9s var(--ease-out) calc(0.05s + var(--d) * 0.09s) both; }
    .hero-actions { animation: rise 0.8s var(--ease-out) 0.35s both; }
    .hero-stats { animation: rise 0.8s var(--ease-out) 0.55s both; }
    .hero-photo img { animation: settle 1.4s var(--ease-out) both; }
    @keyframes settle { from { transform: scale(1.08); } }
  }

  @media (max-width: 820px) {
    /* Zdjęcie jako mały portret obok imienia i roli, nie osobny blok nad nagłówkiem.
       .hero-main znika z układu, jego dzieci stają się elementami siatki. */
    .hero-grid { grid-template-columns: 64px minmax(0, 1fr); gap: 0 var(--space-3); align-items: center; }
    .hero-main { display: contents; }
    .hero-main > * { grid-column: 1 / -1; }
    .hero-photo { grid-column: 1; grid-row: 1; width: 64px; -webkit-mask-image: none; mask-image: none; }
    .hero-photo img { aspect-ratio: 1; }
    .hero-main > .eyebrow { grid-column: 2; grid-row: 1; margin: 0; line-height: 1.5; }
    .eyebrow span { display: block; }
    .eyebrow .eb-sep { display: none; }
    .hero-name { margin-top: var(--space-5); }

    /* Liczby w stałej kolumnie po lewej, opis w drugiej: wszystkie wiersze w tych samych liniach */
    .hero-stats { grid-template-columns: 1fr; }
    .hero-stats li, .hero-stats li + li {
      display: grid;
      grid-template-columns: minmax(0, 9.5rem) minmax(0, 1fr);
      align-items: baseline;
      gap: var(--space-3);
      padding: var(--space-3) 0;
      border-left: 0;
      border-bottom: 1px solid var(--line);
    }
  }
</style>
