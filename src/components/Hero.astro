---
import { dicts, SITE, type Lang } from "../i18n";
interface Props { lang: Lang }
const t = dicts[Astro.props.lang].hero;
---
<section id="top" class="hero">
  <div class="wrap hero-grid">
    <div class="hero-main">
      <p class="eyebrow">{t.eyebrow}</p>
      <h1 class="hero-title">{t.name}</h1>
      <p class="hero-sub">{t.lead}</p>
      <p class="hero-thesis">{t.thesis[0]}<br /><span class="hl">{t.thesis[1]}</span></p>
      <div class="hero-actions">
        <a href={`mailto:${SITE.email}`} class="btn btn-primary">{t.ctaPrimary} →</a>
        <a href={SITE.linkedin} class="hero-link" target="_blank" rel="noopener">{t.ctaSecondary}</a>
      </div>
    </div>
    <img class="hero-photo" src="/kamil.jpg" alt={t.name} width="320" height="320" />
  </div>

  <div class="wrap">
    <div class="dash" role="list" aria-label={t.statsLabel}>
      {t.stats.map((s) => (
        <div class="dash-cell" role="listitem">
          <span class="dash-num">{s.num}</span>
          <span class="dash-label">{s.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hero { padding-top: clamp(3rem, 7vw, 5.5rem); }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    margin-bottom: clamp(3rem, 7vw, 5rem);
  }
  .hero-title {
    font-size: var(--step-4);
    margin-bottom: 1.4rem;
    overflow-wrap: break-word;
  }
  .hero-photo {
    width: clamp(180px, 24vw, 320px);
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 3px;
    border: 1px solid var(--line);
  }
  .hero-thesis {
    font-family: var(--display);
    font-size: var(--step-2);
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin-bottom: 2rem;
  }
  @media (max-width: 760px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-photo { order: -1; width: 140px; }
  }
  .hl {
    color: var(--accent);
  }
  .hero-sub {
    max-width: 56ch;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-soft);
    margin-bottom: 1.6rem;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .hero-link {
    font-weight: 600;
    text-decoration: none;
    border-bottom: 2px solid var(--line);
    padding-bottom: 2px;
    transition: border-color 0.15s ease;
  }
  .hero-link:hover { border-color: var(--accent); }

  /* Signature element - deska rozdzielcza liczb */
  .dash {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--ink);
  }
  .dash-cell {
    padding: 1.6rem 1.6rem;
    border-right: 1px solid var(--line);
  }
  .dash-cell:first-child { padding-left: 0; }
  .dash-cell:last-child { border-right: 0; padding-right: 0; }
  .dash-num {
    display: block;
    font-family: var(--mono);
    font-size: var(--step-2);
    font-weight: 500;
    color: var(--ink);
    letter-spacing: -0.02em;
    margin-bottom: 0.6rem;
  }
  .dash-label {
    display: block;
    font-size: var(--step--1);
    line-height: 1.4;
    color: var(--ink-soft);
    max-width: 30ch;
  }
  @media (max-width: 760px) {
    .dash { grid-template-columns: 1fr; }
    .dash-cell {
      border-right: 0;
      border-bottom: 1px solid var(--line);
      padding: 1.6rem 0;
    }
    .dash-cell:last-child { border-bottom: 0; }
  }
</style>
