---
const projects = [
  {
    tag: "Fintech · crowdfunding",
    title: "Platforma inwestycyjna dla start-upów",
    metric: "~40 mln zł",
    metricLabel: "zainwestowane · 6 lat działania",
    challenge:
      "Platforma, przez którą przepływają realne pieniądze inwestorów - gdzie błąd oznacza straty i utratę zaufania, a regulacje nie zostawiają miejsca na skróty.",
    role: "Prowadziłem projekt od koncepcji do wdrożenia: architektura, kluczowe decyzje technologiczne, rozwój produktu we współpracy z biznesem.",
  },
  {
    tag: "Cybersecurity",
    title: "System analizy ruchu sieciowego",
    metric: "0 włamań",
    metricLabel: "4000 użytkowników · system pod realnym ostrzałem",
    challenge:
      "System, który sam był celem ataków. Bezpieczeństwo nie było funkcją, było fundamentem - rozwiązanie musiało wytrzymać próby włamań realnych przeciwników.",
    role: "Architektura, prowadzenie zespołu i wdrożenie w chmurze AWS. System przetwarzał i udostępniał do dalszej analizy setki gigabajtów danych.",
  },
  {
    tag: "Fintech · family office",
    title: "Platforma zarządzania majątkiem",
    metric: "SOC 2",
    metricLabel: "certyfikacja w toku · współpraca 2+ lata",
    challenge:
      "Segment, w którym klient powierza aplikacji pełny obraz swoich finansów. Połączenie głębokiej domeny finansowej z najwyższymi wymogami bezpieczeństwa.",
    role: "Kontakt z klientem, prowadzenie zespołu, nadzór nad developerami, wdrożenie w AWS. Prowadzę projekt przez certyfikację bezpieczeństwa SOC 2 od strony technologii.",
  },
  {
    tag: "Lotnictwo",
    title: "Serwisowanie i compliance dla przewoźników",
    metric: "SaaS",
    metricLabel: "od pomysłu klienta do wdrożenia",
    challenge:
      "Branża, gdzie błąd w procesach serwisowych czy zgodności z regulacjami przekłada się bezpośrednio na bezpieczeństwo lotów i ryzyko prawne operatora.",
    role: "Kontakt z klientem, prowadzenie zespołu i nadzór nad developerami. Dwa projekty: optymalizacja serwisowania prywatnych odrzutowców oraz compliance dla firm przewozowych.",
  },
  {
    tag: "Doradztwo · audyt IT",
    title: "Audyt działu IT (300-osobowa firma)",
    metric: "20 osób",
    metricLabel: "wielkość audytowanego działu IT",
    challenge:
      "Ocena, jak realnie pracuje dział IT - procesy, kompetencje, technologia - i wskazanie, co poprawić, bez politycznego lukru.",
    role: "Samodzielny audyt: analiza procesów, rozmowy z zespołem i zarządem, raport z rekomendacjami. Efekt: uporządkowanie procesów i wzrost efektywności zespołu.",
  },
  {
    tag: "Szybki projekt · mobile + web",
    title: "Symulator giełdy w formie gry",
    metric: "3 mies.",
    metricLabel: "od zera do MVP · przed erą AI",
    challenge:
      "Dowiezienie kompletnego produktu na dwie platformy - mobilną i webową - w krótkim czasie.",
    role: "Realizacja end-to-end: od koncepcji po działające aplikacje. Wtedy 3 miesiące; dziś - znacznie szybciej.",
  },
];
---
<section id="projekty" class="proj">
  <div class="wrap">
    <div class="proj-head">
      <p class="eyebrow">Dowód, że dowożę</p>
      <h2 class="proj-title">Za Twoim projektem stoi 16 lat z branż, gdzie błąd kosztuje&nbsp;naprawdę.</h2>
      <p class="proj-lead">
        Nazwy klientów pomijam - liczy się, co robiłem i za co brałem
        odpowiedzialność, nie kto podpisał umowę.
      </p>
    </div>

    <div class="cards">
      {projects.map((p) => (
        <article class="card">
          <div class="card-top">
            <span class="card-tag">{p.tag}</span>
            <div class="card-metric">
              <span class="card-num">{p.metric}</span>
              <span class="card-mlabel">{p.metricLabel}</span>
            </div>
          </div>
          <h3 class="card-title">{p.title}</h3>
          <p class="card-challenge">{p.challenge}</p>
          <hr class="rule card-div" />
          <p class="card-role"><span>Moja rola.</span> {p.role}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .proj-head { max-width: 60ch; margin-bottom: clamp(2.5rem, 6vw, 4rem); }
  .proj-title { font-size: var(--step-3); margin-bottom: 1.2rem; }
  .proj-lead { font-size: var(--step-1); color: var(--ink-soft); line-height: 1.5; }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.5rem;
  }
  .card {
    background: var(--paper-pure);
    border: 1px solid var(--line);
    padding: clamp(1.5rem, 3vw, 2rem);
    display: flex;
    flex-direction: column;
    transition: border-color 0.18s ease, transform 0.18s ease;
  }
  .card:hover { border-color: var(--accent); transform: translateY(-3px); }
  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.2rem;
  }
  .card-tag {
    font-family: var(--mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    color: var(--ink-soft);
    padding-top: 0.35rem;
  }
  .card-metric { text-align: right; flex-shrink: 0; }
  .card-num {
    display: block;
    font-family: var(--mono);
    font-size: var(--step-1);
    font-weight: 500;
    color: var(--accent);
  }
  .card-mlabel {
    display: block;
    font-size: 0.72rem;
    color: var(--ink-soft);
    max-width: 18ch;
    margin-left: auto;
    line-height: 1.35;
    margin-top: 0.25rem;
  }
  .card-title { font-size: var(--step-1); margin-bottom: 0.8rem; }
  .card-challenge { color: var(--ink-soft); font-size: var(--step-0); margin-bottom: 1.2rem; }
  .card-div { margin-bottom: 1.2rem; }
  .card-role { font-size: var(--step--1); line-height: 1.5; margin-top: auto; }
  .card-role span { color: var(--accent); font-weight: 600; }
</style>
