---
import { dicts, type Lang } from "../i18n";
interface Props { lang: Lang }
const t = dicts[Astro.props.lang].work;
---
<section id="work" class="proj">
  <div class="wrap">
    <div class="proj-head">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 class="proj-title">{t.title}</h2>
    </div>

    <div class="cards">
      {t.projects.map((p) => (
        <article class="card">
          <div class="card-top">
            <span class="card-tag">{p.tag}</span>
            <div class="card-metric">
              <span class="card-num">{p.metric}</span>
              <span class="card-mlabel">{p.metricLabel}</span>
            </div>
          </div>
          <h3 class="card-title">{p.title}</h3>
          <dl class="card-body">
            <dt>{t.labels.problem}</dt>
            <dd>{p.problem}</dd>
            <dt>{t.labels.did}</dt>
            <dd>{p.did}</dd>
            {p.result && <dt>{t.labels.result}</dt>}
            {p.result && <dd>{p.result}</dd>}
          </dl>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .proj-head { max-width: 60ch; margin-bottom: clamp(2.5rem, 6vw, 4rem); }
  .proj-title { font-size: var(--step-3); margin-bottom: 1.2rem; }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr));
    gap: 1.5rem;
  }
  .card {
    background: var(--paper-pure);
    border: 1px solid var(--line);
    padding: clamp(1.5rem, 3vw, 2rem);
    display: flex;
    flex-direction: column;
    transition: border-color 0.18s ease, transform 0.18s ease;
  }
  .card:hover { border-color: var(--accent); transform: translateY(-3px); }
  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.2rem;
  }
  .card-tag {
    font-family: var(--mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    color: var(--ink-soft);
    padding-top: 0.35rem;
  }
  .card-metric { text-align: right; flex-shrink: 0; }
  .card-num {
    display: block;
    font-family: var(--mono);
    font-size: var(--step-1);
    font-weight: 500;
    color: var(--accent);
  }
  .card-mlabel {
    display: block;
    font-size: 0.72rem;
    color: var(--ink-soft);
    max-width: 18ch;
    margin-left: auto;
    line-height: 1.35;
    margin-top: 0.25rem;
  }
  .card-title { font-size: var(--step-1); margin-bottom: 0.8rem; }
  .card-body dt {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-top: 1rem;
  }
  .card-body dt:first-child { margin-top: 0; }
  .card-body dd {
    font-size: var(--step--1);
    line-height: 1.55;
    color: var(--ink-soft);
    margin-top: 0.25rem;
  }
</style>
