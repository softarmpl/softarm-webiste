---
import { dicts, type Lang } from "../i18n";
import SectionHeader from "./SectionHeader.astro";
interface Props { lang: Lang }
const t = dicts[Astro.props.lang].work;
---
<section id="work" class="proj">
  <div class="wrap">
    <SectionHeader eyebrow={t.eyebrow} title={t.title} />

    <div class="cards" data-reveal>
      {t.projects.map((p) => (
        <article class="card">
          <span class="card-tag label">{p.tag}</span>
          <h3 class="card-title">{p.title}</h3>
          <p class="card-metric">
            {p.metric && <span class="card-num">{p.metric}</span>}
            <span class="card-mlabel">{p.metricLabel}</span>
          </p>
          <dl class="card-body">
            <div>
              <dt class="label">{t.labels.problem}</dt>
              <dd>{p.problem}</dd>
            </div>
            <div>
              <dt class="label">{t.labels.did}</dt>
              <dd>{p.did}</dd>
            </div>
            {p.result && (
              <div class="card-result">
                <dt class="label">{t.labels.result}</dt>
                <dd>{p.result}</dd>
              </div>
            )}
          </dl>
          {p.stack.length > 0 && (
            <ul class="card-stack">
              {p.stack.map((s) => <li>{s}</li>)}
            </ul>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 460px), 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  /* Karty stykają się, linie między nimi to tło siatki */
  .card {
    background: var(--ground);
    padding: clamp(var(--space-4), 3.5vw, var(--space-5));
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    transition: background 0.15s ease;
  }
  .card:hover { background: var(--ground-raised); }
  .card-tag { margin-bottom: var(--space-4); }
  .card-title { font-size: var(--fs-heading); margin-bottom: var(--space-3); max-width: 22ch; text-wrap: balance; }
  .card-metric { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-1) var(--space-3); margin-bottom: var(--space-5); }
  .card-num {
    font-family: var(--font-display);
    font-size: var(--fs-heading);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--signal-ink);
    white-space: nowrap;
  }
  .card-mlabel { font-size: var(--fs-small); color: var(--ink-muted); }
  .card-body { display: flex; flex-direction: column; gap: var(--space-4); align-self: stretch; }
  .card-body dt { margin-bottom: var(--space-2); }
  .card-body dd { font-size: 1rem; line-height: 1.55; color: var(--ink-muted); }
  .card-result { padding-top: var(--space-4); border-top: 1px solid var(--line); }
  .card-result dt { color: var(--signal-ink); }
  .card-result dd { color: var(--ink); }
  .card-stack { list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-5); }
  .card-stack li {
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--ink-muted);
    box-shadow: inset 0 0 0 1px var(--control);
    border-radius: var(--radius-pill);
    padding: 0.25rem 0.7rem;
  }
</style>
