---
import { dicts, type Lang } from "../i18n";
interface Props { lang: Lang }
const t = dicts[Astro.props.lang].about;
---
<section id="about" class="about">
  <div class="wrap about-grid">
    <div>
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 class="about-title">{t.title}</h2>
      {t.paragraphs.map((p) => <p class="about-p">{p}</p>)}
    </div>
    <div>
      <h3 class="about-how">{t.howTitle}</h3>
      <ul class="about-list">
        {t.how.map((h) => (
          <li class="about-item">
            <strong>{h.title}</strong> {h.body}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .about { background: var(--ink); color: var(--paper); }
  .about .eyebrow { color: #6fb4a0; }
  .about-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2rem, 6vw, 4.5rem);
    align-items: start;
  }
  .about-title {
    font-size: var(--step-3);
    color: var(--paper);
    margin-bottom: 1.6rem;
  }
  .about-p {
    color: #b9c2cc;
    line-height: 1.65;
    max-width: 56ch;
    margin-bottom: 1.1rem;
  }
  .about-how {
    font-family: var(--mono);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #6fb4a0;
    margin-bottom: 1rem;
    padding-top: 0.3rem;
  }
  .about-list { list-style: none; }
  .about-item {
    color: #b9c2cc;
    padding-block: 1.2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }
  .about-item strong {
    color: var(--paper);
    font-family: var(--display);
    font-weight: 500;
    font-size: var(--step-1);
    display: block;
    margin-bottom: 0.3rem;
  }
  @media (max-width: 820px) {
    .about-grid { grid-template-columns: 1fr; }
  }
</style>
