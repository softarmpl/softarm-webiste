---
import { dicts, type Lang } from "../i18n";
import SectionHeader from "./SectionHeader.astro";
interface Props { lang: Lang }
const d = dicts[Astro.props.lang];
const t = d.about;
const x = d.experience;
---
<section id="about" class="about paper">
  <div class="wrap about-grid">
    <div>
      <SectionHeader eyebrow={t.eyebrow} title={t.title} highlight={d.hero.thesis[1]} />
      {t.paragraphs.map((p) => <p class="about-p" data-reveal>{p}</p>)}

      <h3 class="tl-title" data-reveal>{x.title}</h3>
      <ol class="tl" data-reveal-group>
        {x.items.map((i) => (
          <li>
            <span class="tl-period">{i.period}</span>
            <span class="tl-org">{i.org}</span>
            <span class="tl-role">{i.role}</span>
          </li>
        ))}
      </ol>
      <p class="tl-cred" data-reveal>{x.credentials.join(" · ")}</p>
    </div>
    <div class="how">
      <h3 class="how-title" data-reveal>{t.howTitle}</h3>
      <ol class="how-list" data-reveal-group>
        {t.how.map((h, i) => (
          <li class="how-item">
            <span class="how-n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <div>
              <p class="how-h">{h.title}</p>
              <p class="how-b">{h.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(var(--space-5), 7vw, var(--space-7));
    align-items: start;
  }
  .about :global(.sh) { margin-bottom: var(--space-5); }
  .about-p { font-size: var(--fs-lead); line-height: 1.45; max-width: 46ch; margin-bottom: var(--space-4); }

  /* Doświadczenie jako krótka oś */
  .tl-title { font-size: var(--fs-heading); margin-top: var(--space-6); margin-bottom: var(--space-4); }
  .tl { list-style: none; border-top: 1px solid var(--line-strong); }
  .tl li {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr) minmax(0, 1.2fr);
    gap: var(--space-3);
    align-items: baseline;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--line);
  }
  .tl-period { font-size: var(--fs-small); color: var(--ink-muted); font-variant-numeric: tabular-nums; }
  .tl-org { font-weight: 500; }
  .tl-role { font-size: var(--fs-small); color: var(--ink-muted); }
  .tl-cred { font-size: var(--fs-small); color: var(--ink-muted); margin-top: var(--space-4); max-width: 58ch; }

  .how-title { font-size: var(--fs-heading); margin-bottom: var(--space-4); }
  .how-list { list-style: none; border-top: 1px solid var(--line-strong); }
  .how-item {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: var(--space-3);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--line);
  }
  .how-n {
    font-family: var(--font-display);
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--signal-ink);
    padding-top: 0.35rem;
  }
  .how-h { font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; line-height: 1.2; letter-spacing: -0.02em; margin-bottom: var(--space-2); }
  .how-b { color: var(--ink-muted); }
  @media (max-width: 860px) {
    .about-grid { grid-template-columns: 1fr; }
    .how { margin-top: var(--space-4); }
  }
  @media (max-width: 520px) {
    .tl li { grid-template-columns: 5.5rem minmax(0, 1fr); }
    .tl-role { grid-column: 2; }
  }
</style>
