---
import { dicts, type Lang } from "../i18n";
interface Props { lang: Lang }
const t = dicts[Astro.props.lang].testimonial;
---
<section id="recommendation" class="tm paper">
  <div class="wrap">
    <figure class="tm-card">
      <p class="eyebrow tm-eyebrow">{t.eyebrow}</p>
      <blockquote class="tm-quote statement">{Astro.props.lang === "pl" ? "„" : "“"}{t.quote}”</blockquote>
      <figcaption class="tm-by">
        <img
          class="tm-avatar"
          src="/oleg.jpg"
          alt="Oleg Sinitsin"
          width="64"
          height="64"
          loading="lazy"
        />
        <span class="tm-meta">
          <span class="tm-name">Oleg Sinitsin</span>
          <span class="tm-role">{t.role}</span>
          <span class="tm-ctx">{t.ctx}</span>
        </span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .tm-card {
    margin: 0;
    display: grid;
    grid-template-columns: minmax(0, 200px) minmax(0, 1fr);
    gap: var(--space-5);
  }
  .tm-eyebrow { grid-column: 1; grid-row: 1; margin: 0.6rem 0 0; }
  .tm-quote {
    grid-column: 2;
    max-width: 30ch;
    text-wrap: pretty;
  }
  .tm-by { grid-column: 2; display: flex; align-items: center; gap: var(--space-3); padding-top: var(--space-4); border-top: 1px solid var(--line); max-width: 46rem; }
  .tm-avatar {
    width: 56px;
    height: 56px;
    object-fit: cover;
    flex-shrink: 0;
  }
  .tm-meta { display: flex; flex-direction: column; line-height: 1.35; }
  .tm-name { font-weight: 500; }
  .tm-role, .tm-ctx { font-size: var(--fs-small); color: var(--ink-muted); }
  @media (max-width: 760px) {
    .tm-card { grid-template-columns: 1fr; gap: var(--space-4); }
    .tm-eyebrow, .tm-quote, .tm-by { grid-column: 1; grid-row: auto; }
  }
</style>
