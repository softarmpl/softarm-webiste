---
const reasons = [
  {
    title: "Rozmawiam biznesem, nie technologią",
    body: "Nie usłyszysz ode mnie o frameworkach. Usłyszysz, ile co kosztuje, ile trwa i jakie niesie ryzyko. To ta wiedza - nie kod - oszczędza Ci najwięcej pieniędzy w MVP.",
  },
  {
    title: "Jedna osoba, zero zepsutego telefonu",
    body: "W agencji Twój pomysł wędruje przez handlowca, PM-a i trzech programistów. U mnie masz jedną osobę, która rozumie projekt, prowadzi go i buduje - a gdy trzeba, dokłada sprawdzonego specjalistę. Rozmawiasz zawsze ze mną i ze mnie rozliczasz wynik.",
  },
  {
    title: "Gwarancja na piśmie",
    body: "Stała cena. Stały termin. Nie zdążę na czas z mojej winy - dokańczam za darmo. Dwie rundy poprawek w cenie, większe zmiany zakresu zawsze wyceniam przed wykonaniem, nigdy po fakcie.",
  },
];
---
<section id="dlaczego-warto" class="why">
  <div class="wrap why-grid">
    <div class="why-left">
      <p class="eyebrow">Dlaczego warto</p>
      <h2 class="why-title">Kupujesz pewność, że&nbsp;to&nbsp;dowiozę.</h2>
      <div class="why-me">
        <img
          class="why-photo"
          src="/kamil.jpg"
          alt="Kamil Wałdoch"
          width="112"
          height="112"
          loading="lazy"
        />
        <span class="why-name">Kamil Wałdoch<br /><span class="why-name-sub">SoftArm</span></span>
      </div>
      <p class="why-bio">
        Jestem Kamil Wałdoch. Od 16 lat buduję aplikacje internetowe - jako
        programista, tech lead i doradca. Prowadziłem projekty w fintechu,
        cyberbezpieczeństwie i lotnictwie: tam, gdzie błąd ma cenę. Pracowałem
        z biznesem po jednej stronie stołu i z zespołami IT po drugiej, więc
        tłumaczę między tymi światami płynnie. Nowoczesne narzędzia, w tym AI,
        pozwalają mi pracować szybciej - ale o jakości i bezpieczeństwie
        decyduje 16 lat doświadczenia, nie narzędzie.
      </p>
    </div>
    <ul class="why-list">
      {reasons.map((r) => (
        <li class="why-item">
          <h3 class="why-item-title">{r.title}</h3>
          <p class="why-item-body">{r.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .why { background: var(--ink); color: var(--paper); }
  .why .eyebrow { color: #6fb4a0; }
  .why-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 4.5rem);
    align-items: start;
  }
  .why-title {
    font-size: var(--step-3);
    color: var(--paper);
    margin-bottom: 1.4rem;
  }
  .why-me {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .why-photo {
    width: 112px;
    height: 112px;
    object-fit: cover;
    border-radius: 3px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    flex-shrink: 0;
  }
  .why-name {
    font-family: var(--display);
    font-size: var(--step-1);
    color: var(--paper);
    line-height: 1.25;
  }
  .why-name-sub {
    font-family: var(--mono);
    font-size: var(--step--1);
    color: #6fb4a0;
  }
  .why-bio {
    color: #b9c2cc;
    font-size: var(--step-0);
    line-height: 1.65;
    max-width: 48ch;
  }
  .why-list { list-style: none; display: flex; flex-direction: column; }
  .why-item {
    padding-block: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }
  .why-item:first-child { padding-top: 0; border-top: 0; }
  .why-item-title {
    font-size: var(--step-1);
    color: var(--paper);
    margin-bottom: 0.5rem;
  }
  .why-item-body { color: #b9c2cc; font-size: var(--step-0); }
  @media (max-width: 820px) {
    .why-grid { grid-template-columns: 1fr; }
  }
</style>
